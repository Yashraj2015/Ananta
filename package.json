{
  "name": "ananta",
  "version": "0.1.0",
  "description": "Ananta DB — Independent multi-protocol database platform",
  "private": true,
  "workspaces": [
    "server",
    "kavacha",
    "gateway",
    "sdk",
    "shim"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:kavacha": "npm run dev --workspace=kavacha",
    "build:sdk": "npm run build --workspace=sdk",
    "build:gateway": "npm run build --workspace=gateway",
    "start": "concurrently \"npm run dev:kavacha\" \"npm run dev:server\""
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
