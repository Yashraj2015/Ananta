# ═══════════════════════════════════════════════════════════════
# Ananta DB — .gitignore
# CRITICAL: No credentials, no vendor names in committed code
# ═══════════════════════════════════════════════════════════════

# Environment files — NEVER commit real credentials
.env
.env.local
.env.production
.env.*
!.env.example

# Kavacha certificates — NEVER commit
kavacha/certs/*.pem
kavacha/certs/*.key
kavacha/certs/*.crt
kavacha/certs/*.p12
kavacha/certs/*.pfx

# Node
node_modules/
dist/
build/
.next/
out/

# Go binaries
*.exe
*.test
/bin/

# Rust/PgCat build artifacts
target/

# Elixir/Realtime
_build/
deps/
*.beam

# Logs — codenames only, still don't commit
*.log
logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/settings.json
.idea/
*.swp

# Test coverage
coverage/
.nyc_output/

# Database files
*.db
*.sqlite
*.sqlite3

# Temporary files
tmp/
temp/
.tmp/

# Docker volumes (local)
docker/volumes/

# pnpm
.pnpm-store/
pnpm-lock.yaml

# Turbo cache
.turbo/

# Vercel
.vercel/

# Wrangler (CF Workers)
.wrangler/

# BullMQ / Redis dump
dump.rdb

# Sharp prebuilds (auto-downloaded)
node_modules/sharp/build/

# Internal notes that might contain vendor names
INTERNAL_NOTES.md
VENDOR_MAP.md
