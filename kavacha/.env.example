# Server
PORT=4001
NODE_ENV=production

# mTLS certificates (Kavacha acts as server, presents these)
KAVACHA_TLS_CERT_PATH=./certs/kavacha-server.pem
KAVACHA_TLS_KEY_PATH=./certs/kavacha-server.key
KAVACHA_CA_PATH=./certs/ca.pem

# Allowed IPs (comma-separated, only Ananta server IPs)
ALLOWED_IPS=127.0.0.1

# Master encryption key (for encrypting audit logs)
KAVACHA_MASTER_KEY=

# Node A: Atlas clusters (internal Smars MongoDB)
NODE_A1_URI=
NODE_A1_ADMIN_PUBLIC_KEY=
NODE_A1_ADMIN_PRIVATE_KEY=
NODE_A1_GROUP_ID=
NODE_A2_URI=
NODE_A3_URI=

# Node N: Neon PostgreSQL projects (customer data)
NODE_N1_ADMIN_URI=
NODE_N2_ADMIN_URI=
NODE_N3_ADMIN_URI=

# Node S: Control plane (Supabase)
NODE_S1_URL=
NODE_S1_SERVICE_KEY=
NODE_S2_URL=
NODE_S2_SERVICE_KEY=

# Node R2: R2 file storage
NODE_R2A_ACCOUNT_ID=
NODE_R2A_ACCESS_KEY=
NODE_R2A_SECRET_KEY=
NODE_R2A_BUCKET=
NODE_R2B_ACCOUNT_ID=
NODE_R2B_ACCESS_KEY=
NODE_R2B_SECRET_KEY=
NODE_R2B_BUCKET=

# Node V: Valkey/Redis
NODE_V1_URL=
NODE_V2_URL=

# CF Stream (paid video)
CF_STREAM_ACCOUNT_ID=
CF_STREAM_API_TOKEN=

# Alert webhook (private Telegram or Discord)
ALERT_WEBHOOK_URL=
