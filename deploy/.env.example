# ============================================================
# Ananta DB — Environment Variables
# Copy this to .env and fill ALL values before running
# NEVER commit the filled .env file
# ============================================================

# ── Kavacha ──────────────────────────────────────────────────
KAVACHA_SHARED_SECRET=change-me-minimum-32-chars-random
KAVACHA_ALLOWED_IPS=  # comma-separated, leave empty in dev
ALERT_WEBHOOK_URL=    # Telegram/Slack webhook for alerts

# ── Atlas Nodes (MongoDB clusters, codename: node-a1..a3) ────
NODE_A1_URI=mongodb+srv://user:pass@cluster0.abcde.mongodb.net/ananta
NODE_A2_URI=
NODE_A3_URI=
NODE_A1_GROUP_ID=          # Atlas project ID
NODE_A1_ADMIN_PUBLIC_KEY=  # Atlas Admin API public key
NODE_A1_ADMIN_PRIVATE_KEY= # Atlas Admin API private key
NODE_A1_ADMIN_USERNAME=admin

# ── Neon Nodes (PostgreSQL, codename: node-n1..n3) ───────────
NODE_N1_ADMIN_URI=postgresql://user:pass@host.neon.tech/neondb?sslmode=require
NODE_N2_ADMIN_URI=
NODE_N3_ADMIN_URI=

# ── Ctrl-Plane (codename: node-s1, node-s2) ──────────────────
NODE_S1_URL=https://xxxxxxxxxxx.supabase.co
NODE_S1_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NODE_S1_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NODE_S2_URL=
NODE_S2_SERVICE_KEY=

# ── R2 Storage (codename: node-r2a, node-r2b) ────────────────
NODE_R2A_ACCESS_KEY=
NODE_R2A_SECRET_KEY=
NODE_R2A_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
NODE_R2A_BUCKET=ananta-files-a
NODE_R2A_ACCOUNT_ID=
NODE_R2B_ACCESS_KEY=
NODE_R2B_SECRET_KEY=
NODE_R2B_ENDPOINT=
NODE_R2B_BUCKET=ananta-files-b

# ── Valkey/Redis (codename: node-vk1, node-vk2) ──────────────
NODE_VK1_URL=rediss://default:password@hostname:6379
NODE_VK2_URL=

# ── Server ────────────────────────────────────────────────────
ANANTA_JWT_SECRET=change-me-minimum-32-chars-random
INTERNAL_BROKER_KEY=change-me-minimum-32-chars-random
ANANTA_FILES_CDN=https://files.ananta.io
ANANTA_SITE_URL=https://ananta.io

# ── Cloudflare Stream (paid video — optional) ─────────────────
CF_STREAM_ACCOUNT=
CF_STREAM_TOKEN=

# ── GoTrue SMTP ───────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=

# ── Neon direct (for Realtime, PgCat) ────────────────────────
NEON_HOST=host.neon.tech
NEON_DB_NAME=neondb
NEON_USER=neondb_owner
NEON_PASSWORD=
PG_APP_PASSWORD=change-me-random
