# Ananta Production Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit your .env file to git.

# ── Authentication Secrets ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ANANTA_JWT_SECRET=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_BROKER_KEY=
KAVACHA_SHARED_SECRET=

# ── Google OAuth ────────────────────────────────────────────────────────────
# Get from: console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Public URLs (used in OAuth redirect URIs) ───────────────────────────────
# MUST match what you register in Google Console as "Authorized redirect URI":
# Add: https://api.yourdomain.com/v1/auth/google/callback
ANANTA_PUBLIC_URL=https://api.yourdomain.com
STUDIO_URL=https://app.yourdomain.com

# Admin email — this account always gets the 'admin' role
ANANTA_ADMIN_EMAIL=your@email.com

# ── Control Plane Database (Supabase) ────────────────────────────────────────
CTRL_PLANE_URL=https://xxxx.supabase.co
CTRL_PLANE_KEY=eyJhbGci...
CTRL_PLANE_POOLER_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (Studio URL + any app domains)
ALLOWED_ORIGINS=https://app.yourdomain.com

# ── Optional: Port overrides ─────────────────────────────────────────────────
# PORT_API=8080
# PORT_FILES=8081
# PORT_HEALTH=3001
# PORT_MONGO=27017
